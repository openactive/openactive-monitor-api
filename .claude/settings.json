{
  "permissions": {
    "allow": [
      "mcp__bigquery__execute_sql"
    ],
    "ask": ["mcp__bigquery__execute_sql"],
    "deny": [
      "mcp__bigquery__analyze_contribution",
      "mcp__bigquery__ask_data_insights",
      "mcp__bigquery__forecast",
      "Bash(bq:*)",
      "Bash(gcloud:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__bigquery__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bigquery-guard.mjs\""
          }
        ]
      }
    ]
  }
}
